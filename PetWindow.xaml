<Window x:Class="TokenPet.PetWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TokenPet · 우사기" Width="300" Height="300" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" Topmost="True" FontFamily="Segoe UI, Malgun Gothic"
 Foreground="#F2F6F5" MouseLeftButtonDown="DragWindow">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#AFBDB8"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#30443D"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="10">
  <Border x:Name="Card" Background="#F516211E" BorderBrush="#394D44" BorderThickness="1" CornerRadius="22" Padding="20,16" VerticalAlignment="Top">
   <StackPanel>
    <Grid>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#B5E6A2" Margin="0,0,8,0"/><TextBlock Text="TOKENPET" FontSize="11" FontWeight="Bold" Foreground="#BBCEBF"/></StackPanel>
     <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Content="—" Click="Minimize" AutomationProperties.Name="최소화"/>
      <Button Content="×" Click="Exit" AutomationProperties.Name="종료" FontSize="16" Padding="8,0"/>
     </StackPanel>
    </Grid>
    <Grid Margin="0,18,0,0">
     <StackPanel><TextBlock x:Name="Provider" Text="Codex" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="남은 사용 한도" Foreground="#92A79C" FontSize="11" Margin="0,3,0,0"/></StackPanel>
     <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#293D32" CornerRadius="9" Padding="9,5"><TextBlock x:Name="Badge" Text="연결 대기" FontSize="10" Foreground="#BAE7A8"/></Border>
    </Grid>
    <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"><StackPanel x:Name="QuotaRows"/></ScrollViewer>
    <TextBlock x:Name="Status" Text="Codex에 연결하고 있어요…" TextWrapping="Wrap" FontSize="11" Foreground="#A4B6AC" Margin="0,13,0,0"/>
    <Border Height="1" Background="#304038" Margin="0,15,0,10"/>
    <Grid><Button x:Name="RefreshButton" Content="↻  새로고침" Click="RefreshClick" HorizontalAlignment="Left" Padding="0,4,8,4" FontSize="11"/>
     <Button Content="연동 설정  ›" Click="SettingsClick" HorizontalAlignment="Right" Padding="8,4,0,4" FontSize="11"/></Grid>
   </StackPanel>
  </Border>
  <Grid x:Name="SummaryBubble" Width="190" VerticalAlignment="Bottom" Margin="0,0,0,184"
   ToolTip="남은 사용 한도 · 우클릭으로 상세 화면 열기">
   <Grid.RenderTransform><TranslateTransform x:Name="BubbleMove"/></Grid.RenderTransform>
   <Border Background="#FAFFF9E8" BorderBrush="#E4D4AA" BorderThickness="1" CornerRadius="15" Padding="12,8,12,10" Margin="0,0,0,6">
    <StackPanel HorizontalAlignment="Center">
     <TextBlock x:Name="SummaryTitle" Text="Codex · 남은 한도" FontSize="10" Foreground="#7B745E" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="164"/>
     <TextBlock x:Name="SummaryValue" Text="사용량 확인 중…" FontSize="13" FontWeight="SemiBold" Foreground="#454531" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="164"/>
    </StackPanel>
   </Border>
   <Path Data="M 0,0 L 7,7 L 14,0" Fill="#FFF9E8" Stroke="#E4D4AA" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
  </Grid>
  <Grid x:Name="Pet" Width="280" Height="190" VerticalAlignment="Bottom" Margin="0,0,0,40" ToolTip="더블클릭하면 인사해요 · 드래그로 이동 · 우클릭으로 동작 선택">
   <Image x:Name="RabbitImage" Width="184" Height="184" Stretch="Uniform" RenderTransformOrigin="0.5,0.85"
    RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="첨부 캐릭터로 만든 토끼 펫"/>
  </Grid>
  <TextBlock x:Name="MotionLabel" Text="대기 · 자동" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" Foreground="#C7CC9D" Margin="0,0,0,23"/>
  <TextBlock x:Name="PetCaption" Text="토큰 지킴이 토끼" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="11" Foreground="#7C9585" Margin="0,0,0,3"/>
 </Grid>
</Window>
